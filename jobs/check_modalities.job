#!/bin/bash

#SBATCH --job-name=CheckModalities
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --time=00:10:00
#SBATCH --output=slurm_check_modalities_%A.out

module purge
module load 2025
module load Anaconda3/2025.06-1

# Properly activate conda environment
source "$(conda info --base)/etc/profile.d/conda.sh"
conda activate rscl

export PYTHONPATH=$HOME/vla-rscl/Isaac-GR00T:$PYTHONPATH
cd $HOME/vla-rscl

if [ -f .env ]; then set -a; source .env; set +a; fi

echo "=== Checking LiberoDataConfig modalities ==="
python -c "
import sys
sys.path.insert(0, 'Isaac-GR00T')
from gr00t.experiment.data_config import load_data_config
config = load_data_config('examples.Libero.custom_data_config:LiberoDataConfig')
import json
print(json.dumps(config.modality_config(), indent=2))
"

echo ""
echo "=== Checking RoboCasa (fourier_gr1_arms_waist) modalities ==="
python -c "
import sys
sys.path.insert(0, 'Isaac-GR00T')
from gr00t.experiment.data_config import load_data_config
config = load_data_config('fourier_gr1_arms_waist')
import json
print(json.dumps(config.modality_config(), indent=2))
"
