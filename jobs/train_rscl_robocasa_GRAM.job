#!/bin/bash

#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --job-name=GRAM-RC
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=18
#SBATCH --time=16:00:00
#SBATCH --output=slurm_gram_robocasa_30_%A.out

module purge
module load 2025
module load Anaconda3/2025.06-1
module load FFmpeg/7.1.1-GCCcore-14.2.0
eval "$(conda shell.bash hook)"
conda activate rscl

export PATH=$HOME/.conda/envs/rscl/bin:$PATH
export PYTHONPATH=$HOME/vla-rscl-simon/vla-rscl/Isaac-GR00T:$PYTHONPATH
cd $HOME/vla-rscl-simon/vla-rscl

set -a
source .env
set +a

SCRATCH_OUT=/scratch-shared/scur0198/outputs/gram_robocasa_30
HOME_OUT=$HOME/vla-rscl-simon/vla-rscl/outputs/gram_robocasa_30
mkdir -p $SCRATCH_OUT

DATA_ROOT=data/robocasa
DATASET_PATHS=()
for d in "$DATA_ROOT"/*_1000; do
    [ -d "$d" ] && DATASET_PATHS+=("$d")
done

python -m rscl.train_robocasa_GRAM \
    --dataset_path "${DATASET_PATHS[@]}" \
    --output_dir $SCRATCH_OUT \
    --data_config fourier_gr1_arms_waist \
    --embodiment_tag gr1 \
    --tune_visual \
    --contrastive_loss rscl_gram \
    --tau 0.2 \
    --beta 0.3 \
    --w_q 1.0 \
    --w_depth 1.0 \
    --w_vel 1.0 \
    --max_steps 30000 \
    --batch_size 8 \
    --gradient_accumulation_steps 8 \
    --save_steps 5000 \
    --save_total_limit 2 \
    --max_demos_per_task 30 \
    --video_backend torchvision_av \
    --seed 0

echo "Copying results back to home..."
mkdir -p $HOME_OUT
cp $SCRATCH_OUT/*.safetensors $SCRATCH_OUT/*.json $HOME_OUT/ 2>/dev/null || true
cp -r $SCRATCH_OUT/experiment_cfg $HOME_OUT/ 2>/dev/null || true
LATEST_CKPT=$(ls -d $SCRATCH_OUT/checkpoint-* 2>/dev/null | sort -t- -k2 -n | tail -1)
if [ -n "$LATEST_CKPT" ]; then
    cp -r "$LATEST_CKPT" $HOME_OUT/
fi
echo "Done. Results in $HOME_OUT"
