#!/bin/bash
# LIBERO eval: matches paper exactly (50 trials/task, all suites)
# usage: sbatch jobs/eval_libero.job <checkpoint_dir> <run_name>
# example: sbatch jobs/eval_libero.job /scratch-shared/scur0198/outputs/libero_baseline_20260510_124856 baseline

#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=Eval-LIB
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=18
#SBATCH --time=24:00:00
#SBATCH --output=/scratch-shared/scur0198/logs/eval_libero_%A_%j.out

CHECKPOINT=${1:?usage: sbatch eval_libero.job <checkpoint_dir> <run_name>}
RUN_NAME=${2:-$(basename $CHECKPOINT)}
TIMESTAMP=$(date +%Y%m%d_%H%M%S)
RESULTS_DIR=/scratch-shared/scur0198/results/libero_${RUN_NAME}_${TIMESTAMP}
PORT=$((5555 + RANDOM % 1000))

module purge
module load 2025
module load Anaconda3/2025.06-1
module load FFmpeg/7.1.1-GCCcore-14.2.0

export PATH=$HOME/.conda/envs/rscl/bin:$PATH
export PYTHONPATH=$HOME/vla-rscl/Isaac-GR00T:$PYTHONPATH
export PYTHONUNBUFFERED=1
export MUJOCO_GL=egl
cd $HOME/vla-rscl

if [ -f .env ]; then set -a; source .env; set +a; fi

mkdir -p $RESULTS_DIR

echo "=== LIBERO evaluation ==="
echo "checkpoint: $CHECKPOINT"
echo "run_name: $RUN_NAME"
echo "timestamp: $TIMESTAMP"
echo "results_dir: $RESULTS_DIR"
echo "slurm_job_id: $SLURM_JOB_ID"
echo "node: $(hostname)"
echo "port: $PORT"

# start inference server (matches paper: 8 denoising steps, H=16 action horizon)
python Isaac-GR00T/scripts/inference_service.py \
    --model_path "$CHECKPOINT" \
    --server \
    --data_config examples.Libero.custom_data_config:LiberoDataConfig \
    --denoising-steps 8 \
    --port $PORT \
    --embodiment-tag new_embodiment &

SERVER_PID=$!
echo "server started (pid $SERVER_PID), waiting for model load..."
sleep 90

# eval all 4 suites (paper: 50 trials per task, 10 tasks per suite = 500 episodes per suite)
SUITES=(libero_spatial libero_object libero_goal libero_10)

cd Isaac-GR00T
for SUITE in "${SUITES[@]}"; do
    echo ""
    echo "=== Suite: $SUITE ==="

    python -c "
import torch
_orig = torch.load
def _safe(*a, **kw):
    kw.setdefault('weights_only', False)
    return _orig(*a, **kw)
torch.load = _safe
import sys
sys.argv = ['run_libero_eval', '--task_suite_name', '$SUITE', '--num_trials_per_task', '50', '--port', '$PORT', '--headless']
exec(open('examples/Libero/eval/run_libero_eval.py').read())
" 2>&1 | tee "$RESULTS_DIR/${SUITE}.log"

    echo "=== Done: $SUITE ==="
done
cd ..

kill $SERVER_PID 2>/dev/null

# summary
echo ""
echo "=== RESULTS SUMMARY ==="
for SUITE in "${SUITES[@]}"; do
    RATE=$(grep 'Current total success rate' "$RESULTS_DIR/${SUITE}.log" 2>/dev/null | tail -1 | grep -oP '[0-9.]+$')
    echo "$SUITE: $RATE"
done
echo "results saved to: $RESULTS_DIR"
echo "eval complete"
