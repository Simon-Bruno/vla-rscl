#!/bin/bash

#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=DepthFeat
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --time=01:00:00
#SBATCH --output=slurm_depth_%A.out

module purge
module load 2025
module load Anaconda3/2025.06-1
module load FFmpeg/7.1.1-GCCcore-14.2.0
eval "$(conda shell.bash hook)"
conda activate rscl

export PATH=$HOME/.conda/envs/rscl/bin:$PATH
cd $HOME/vla-rscl-simon/vla-rscl

echo "=== extracting depth maps ==="
echo "tasks: 24, episodes per task: 12, total: ~288 episodes, ~101k frames"

python scripts/extract_depth_maps.py \
    --data_root data/robocasa \
    --n_episodes 12 \
    --batch_size 64 \
    --model_id depth-anything/Depth-Anything-V2-Small-hf

echo "=== done ==="
