#!/bin/bash

#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=GRAM-D
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=18
#SBATCH --time=12:00:00
#SBATCH --output=/scratch-shared/scur0198/slurm_rscl_gram_depth_%A.out

module purge
module load 2025
module load Anaconda3/2025.06-1
module load FFmpeg/7.1.1-GCCcore-14.2.0

export PATH=$HOME/.conda/envs/rscl/bin:$PATH
export PYTHONPATH=$HOME/vla-rscl/Isaac-GR00T:$PYTHONPATH
cd $HOME/vla-rscl

if [ -f .env ]; then set -a; source .env; set +a; fi

export HF_HUB_OFFLINE=1
export TQDM_DISABLE=1
export WANDB_DIR=/scratch-shared/scur0198

# GRAM with depth: visual + proprio + depth (k=3), best single modality from ablation
python -m rscl.train \
    --dataset_path \
        data/libero/libero_10_no_noops_1.0.0_lerobot \
    --output_dir /scratch-shared/scur0198/outputs/libero_rscl_gram_depth \
    --contrastive_loss rscl \
    --tau 0.2 \
    --beta 1.0 \
    --w_q 1.0 \
    --w_depth 0.5 \
    --lambda_gram 0.05 \
    --max_steps 10000 \
    --batch_size 32 \
    --save_steps 2500 \
    --save_total_limit 4 \
    --video_backend torchvision_av \
    --seed 0
