#!/bin/bash
# baseline: no CL, tune_visual, 60K steps, all 4 LIBERO suites, batch 32
# paper-matching setup: GEAR defaults + new_embodiment tag

#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=Base-TV
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=18
#SBATCH --time=48:00:00
#SBATCH --output=/scratch-shared/scur0198/logs/baseline_tv_%A_%j.out

module purge
module load 2025
module load Anaconda3/2025.06-1
module load FFmpeg/7.1.1-GCCcore-14.2.0

export PATH=$HOME/.conda/envs/rscl/bin:$PATH
export PYTHONPATH=$HOME/vla-rscl/Isaac-GR00T:$PYTHONPATH
export PYTHONUNBUFFERED=1
export TQDM_DISABLE=1
export WANDB_DIR=/scratch-shared/scur0198
cd $HOME/vla-rscl

if [ -f .env ]; then set -a; source .env; set +a; fi

TIMESTAMP=$(date +%Y%m%d_%H%M%S)
OUTPUT_DIR=/scratch-shared/scur0198/outputs/libero_baseline_tv_${TIMESTAMP}
mkdir -p $OUTPUT_DIR

cat <<INFO
=== baseline training (tune_visual) ===
specs: no CL | tune_visual=True | 60K steps | bs=32 | lr=1e-4 | all 4 suites | seed=0
timestamp: $TIMESTAMP
output_dir: $OUTPUT_DIR
slurm_job_id: $SLURM_JOB_ID
node: $(hostname)
INFO

python -m rscl.train \
    --dataset_path \
        data/libero/libero_spatial_no_noops_1.0.0_lerobot \
        data/libero/libero_object_no_noops_1.0.0_lerobot \
        data/libero/libero_goal_no_noops_1.0.0_lerobot \
        data/libero/libero_10_no_noops_1.0.0_lerobot \
    --output_dir $OUTPUT_DIR \
    --contrastive_loss none \
    --tune_visual \
    --max_steps 60000 \
    --batch_size 32 \
    --video_backend torchvision_av \
    --seed 0

echo "done. checkpoint: $OUTPUT_DIR"
