#!/bin/bash

#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=EVAL-RC
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=18
#SBATCH --time=24:00:00
#SBATCH --output=/scratch-shared/scur0198/slurm_eval_robocasa_%A.out

# usage: sbatch jobs/eval_robocasa.job <checkpoint_dir>
# example: sbatch jobs/eval_robocasa.job outputs/baseline_robocasa

CHECKPOINT=${1:-outputs/baseline_robocasa}
PORT=$((5555 + RANDOM % 1000))

module purge
module load 2025
module load Anaconda3/2025.06-1
module load FFmpeg/7.1.1-GCCcore-14.2.0
eval "$(conda shell.bash hook)"
conda activate rscl

export PATH=$HOME/.conda/envs/rscl/bin:$PATH
export PYTHONPATH=$HOME/vla-rscl-simon/vla-rscl/Isaac-GR00T:$HOME/vla-rscl-simon/vla-rscl/robocasa-gr1-tabletop-tasks:$HOME/vla-rscl-simon/vla-rscl/robosuite:$PYTHONPATH
export MUJOCO_GL=egl
cd $HOME/vla-rscl-simon/vla-rscl

set -a
source .env
set +a

RUN_NAME=$(basename $(dirname $CHECKPOINT))
TIMESTAMP=$(date +%Y%m%d_%H%M%S)
RESULTS_DIR="/scratch-shared/scur0198/results/${RUN_NAME}_${TIMESTAMP}"
mkdir -p "$RESULTS_DIR"

echo "=== Evaluating checkpoint: $CHECKPOINT ==="
echo "=== Results dir: $RESULTS_DIR ==="

# start inference server
python Isaac-GR00T/scripts/inference_service.py \
    --model_path "$CHECKPOINT" \
    --server \
    --data_config single_panda_gripper \
    --denoising-steps 8 \
    --port $PORT \
    --embodiment-tag new_embodiment &

SERVER_PID=$!
echo "server started (pid $SERVER_PID), waiting for model load..."
sleep 90

# all 24 RoboCasa-Kitchen Panda tasks
TASKS=(
    "robocasa_panda_omron/CloseDoubleDoor_PandaOmron_Env"
    "robocasa_panda_omron/CloseDrawer_PandaOmron_Env"
    "robocasa_panda_omron/CloseSingleDoor_PandaOmron_Env"
    "robocasa_panda_omron/CoffeePressButton_PandaOmron_Env"
    "robocasa_panda_omron/CoffeeServeMug_PandaOmron_Env"
    "robocasa_panda_omron/CoffeeSetupMug_PandaOmron_Env"
    "robocasa_panda_omron/OpenDoubleDoor_PandaOmron_Env"
    "robocasa_panda_omron/OpenDrawer_PandaOmron_Env"
    "robocasa_panda_omron/OpenSingleDoor_PandaOmron_Env"
    "robocasa_panda_omron/PnPCabToCounter_PandaOmron_Env"
    "robocasa_panda_omron/PnPCounterToCab_PandaOmron_Env"
    "robocasa_panda_omron/PnPCounterToMicrowave_PandaOmron_Env"
    "robocasa_panda_omron/PnPCounterToSink_PandaOmron_Env"
    "robocasa_panda_omron/PnPCounterToStove_PandaOmron_Env"
    "robocasa_panda_omron/PnPMicrowaveToCounter_PandaOmron_Env"
    "robocasa_panda_omron/PnPSinkToCounter_PandaOmron_Env"
    "robocasa_panda_omron/PnPStoveToCounter_PandaOmron_Env"
    "robocasa_panda_omron/TurnOffMicrowave_PandaOmron_Env"
    "robocasa_panda_omron/TurnOffSinkFaucet_PandaOmron_Env"
    "robocasa_panda_omron/TurnOffStove_PandaOmron_Env"
    "robocasa_panda_omron/TurnOnMicrowave_PandaOmron_Env"
    "robocasa_panda_omron/TurnOnSinkFaucet_PandaOmron_Env"
    "robocasa_panda_omron/TurnOnStove_PandaOmron_Env"
    "robocasa_panda_omron/TurnSinkSpout_PandaOmron_Env"
)

cd Isaac-GR00T
for TASK in "${TASKS[@]}"; do
    TASK_SHORT=$(echo "$TASK" | sed "s|robocasa_panda_omron/||" | sed "s|_PandaOmron_Env||")
    echo ""
    echo "=== Task: $TASK_SHORT ==="

    python scripts/simulation_service.py --client \
        --env_name "$TASK" \
        --max_episode_steps 500 \
        --n_envs 4 \
        --n_episodes 50 \
        --port $PORT \
        2>&1 | tee "$RESULTS_DIR/${TASK_SHORT}.log"

    echo "=== Done: $TASK_SHORT ==="
done
cd ..

kill $SERVER_PID 2>/dev/null
echo ""
echo "=== All 24 tasks evaluated ==="
echo "Results saved to: $RESULTS_DIR"

# copy results back to home
HOME_RESULTS=$HOME/vla-rscl-simon/vla-rscl/results/${RUN_NAME}_${TIMESTAMP}
mkdir -p $HOME_RESULTS
cp $RESULTS_DIR/*.log $HOME_RESULTS/ 2>/dev/null || true
echo "Logs copied to: $HOME_RESULTS"
