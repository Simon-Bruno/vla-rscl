#!/bin/bash

#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=abl-all
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=18
#SBATCH --time=24:00:00
#SBATCH --output=slurm_ablation_all_%A.out

module purge
module load 2025
module load Anaconda3/2025.06-1
module load FFmpeg/7.1.1-GCCcore-14.2.0
eval "$(conda shell.bash hook)"
conda activate rscl

export PATH=$HOME/.conda/envs/rscl/bin:$PATH
export PYTHONPATH=$HOME/vla-rscl-simon/vla-rscl/Isaac-GR00T:$PYTHONPATH
cd $HOME/vla-rscl-simon/vla-rscl

set -a
source .env
set +a

SCRATCH_OUT=/scratch-shared/scur0198/outputs/ablation_all_30d
HOME_OUT=$HOME/vla-rscl-simon/vla-rscl/outputs/ablation_all_30d
mkdir -p $SCRATCH_OUT

DATA_ROOT=data/robocasa
DATASET_PATHS=()
for d in "$DATA_ROOT"/single_panda_gripper.*; do
    [ -d "$d" ] && DATASET_PATHS+=("$d")
done

python -m rscl.train_robocasa \
    --dataset_path "${DATASET_PATHS[@]}" \
    --output_dir $SCRATCH_OUT \
    --data_config single_panda_gripper \
    --tune_visual \
    --no-tune-diffusion-model \
    --contrastive_loss rscl \
    --tau 0.2 \
    --beta 0.3 \
    --w_q 1.0 \
    --w_depth 1.0 \
    --w_action 1.0 \
    --max_steps 30000 \
    --batch_size 8 \
    --gradient_accumulation_steps 8 \
    --save_steps 5000 \
    --save_total_limit 2 \
    --max_demos_per_task 30 \
    --video_backend torchvision_av \
    --seed 0

echo "Copying results back to home..."
mkdir -p $HOME_OUT
cp $SCRATCH_OUT/*.safetensors $SCRATCH_OUT/*.json $HOME_OUT/ 2>/dev/null || true
cp -r $SCRATCH_OUT/experiment_cfg $HOME_OUT/ 2>/dev/null || true
LATEST_CKPT=$(ls -d $SCRATCH_OUT/checkpoint-* 2>/dev/null | sort -t- -k2 -n | tail -1)
if [ -n "$LATEST_CKPT" ]; then
    cp -r "$LATEST_CKPT" $HOME_OUT/
    cp -r $SCRATCH_OUT/experiment_cfg $HOME_OUT/$(basename $LATEST_CKPT)/ 2>/dev/null || true
fi
echo "Done. Results in $HOME_OUT"
