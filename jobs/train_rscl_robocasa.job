#!/bin/bash

#SBATCH --partition=gpu_a100
#SBATCH --gpus=8
#SBATCH --job-name=RSCL-RC
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=72
#SBATCH --time=48:00:00
#SBATCH --output=slurm_rscl_robocasa_%A.out

module purge
module load 2025
module load Anaconda3/2025.06-1
module load FFmpeg/7.1.1-GCCcore-14.2.0

export PATH=$HOME/.conda/envs/rscl/bin:$PATH
export PYTHONPATH=$HOME/vla-rscl/Isaac-GR00T:$PYTHONPATH
cd $HOME/vla-rscl

if [ -f .env ]; then set -a; source .env; set +a; fi

DATA_ROOT=data/robocasa

# all 24 robocasa tasks (1000 trajectories each)
DATASET_PATHS=()
for d in "$DATA_ROOT"/*_1000; do
    [ -d "$d" ] && DATASET_PATHS+=("$d")
done

python -m rscl.train \
    --dataset_path "${DATASET_PATHS[@]}" \
    --output_dir outputs/rscl_robocasa \
    --data_config fourier_gr1_arms_waist \
    --embodiment_tag gr1 \
    --tune_visual \
    --contrastive_loss rscl \
    --tau 0.2 \
    --beta 1.0 \
    --max_steps 60000 \
    --batch_size 48 \
    --learning_rate 3e-5 \
    --gradient_accumulation_steps 4 \
    --video_backend torchvision_av \
    --seed 0
