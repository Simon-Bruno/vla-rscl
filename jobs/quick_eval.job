#!/bin/bash
# quick eval: 1 LIBERO suite, 30 trials/task, ~45min

#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=Q-Eval
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=18
#SBATCH --time=02:00:00
#SBATCH --output=/scratch-shared/scur0198/slurm_quick_eval_%A.out

# usage: sbatch jobs/quick_eval.job <checkpoint_dir> [suite]
# example: sbatch jobs/quick_eval.job /scratch-shared/scur0198/outputs/quick_rscl libero_spatial

CHECKPOINT=${1:-/scratch-shared/scur0198/outputs/quick_baseline}
SUITE=${2:-libero_spatial}
PORT=$((5555 + RANDOM % 1000))

module purge
module load 2025
module load Anaconda3/2025.06-1
module load FFmpeg/7.1.1-GCCcore-14.2.0

export PATH=$HOME/.conda/envs/rscl/bin:$PATH
export PYTHONPATH=$HOME/vla-rscl/Isaac-GR00T:$PYTHONPATH
export HF_HUB_OFFLINE=1
export MUJOCO_GL=egl
cd $HOME/vla-rscl

if [ -f .env ]; then set -a; source .env; set +a; fi

export TORCH_SERIALIZATION_WEIGHTS_ONLY=0

echo "evaluating checkpoint: $CHECKPOINT on suite: $SUITE"

python Isaac-GR00T/scripts/inference_service.py \
    --model_path "$CHECKPOINT" \
    --server \
    --data_config examples.Libero.custom_data_config:LiberoDataConfig \
    --denoising-steps 8 \
    --port $PORT \
    --embodiment-tag new_embodiment &

SERVER_PID=$!
echo "server started (pid $SERVER_PID), waiting for model load..."
sleep 60

cd Isaac-GR00T
python -m examples.Libero.eval.run_libero_eval \
    --task_suite_name "$SUITE" \
    --num_trials_per_task 30 \
    --port $PORT \
    --headless
cd ..

kill $SERVER_PID 2>/dev/null
echo "eval complete"
