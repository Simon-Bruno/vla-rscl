#!/bin/bash

#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=TrainUniAlign
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=18
#SBATCH --time=48:00:00
#SBATCH --output=slurm_unialign_%A.out

module purge
module load 2025
module load Anaconda3/2025.06-1
module load FFmpeg/7.1.1-GCCcore-14.2.0

source activate rscl
cd $HOME/vla-rscl
export PYTHONPATH=$HOME/vla-rscl/Isaac-GR00T:$PYTHONPATH

# load secrets from gitignored .env (e.g., WANDB_API_KEY)
if [ -f .env ]; then set -a; source .env; set +a; fi

python -c "
from rscl.config import TrainConfig
from rscl.train import train

cfg = TrainConfig(
    device='cuda',
    suite='libero_spatial,libero_object,libero_goal,libero_10',
    total_steps=60000,
    warmup_steps=1000,
    contrastive_loss='unialign',
    lambda_align=1.0,
    seed=0,
)
train(cfg)
"
